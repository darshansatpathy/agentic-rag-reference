# Copy to .env. Every value is optional: with none set, everything runs offline.

# Components: lsa|openai, memory|qdrant, extractive|llm, rule|llm, feature|llm
ARAG_EMBEDDER=lsa
ARAG_VECTOR_STORE=memory
# ARAG_QDRANT_URL=http://localhost:6333
ARAG_ANSWERER=extractive
ARAG_PLANNER=rule
ARAG_RERANKER=feature

# Abstention threshold (see the sweep in the eval report) and agent hops per sub-question
ARAG_MIN_COVERAGE=0.5
ARAG_MAX_HOPS=2

# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, vLLM, Ollama, LiteLLM
# ARAG_LLM_BASE_URL=https://api.openai.com/v1
# ARAG_LLM_MODEL=gpt-4o-mini
# ARAG_LLM_API_KEY=
# ARAG_EMBED_BASE_URL=
# ARAG_EMBED_MODEL=text-embedding-3-small
# ARAG_EMBED_API_KEY=
# For Azure OpenAI set the deployment URL as the base URL and:
# ARAG_AZURE_API_VERSION=2024-10-21

# Shared secret the upstream gateway must send as "Authorization: Bearer ...".
# Unset = development mode (identity headers are trusted).
# ARAG_SERVICE_TOKEN=
ARAG_LOG_LEVEL=INFO
